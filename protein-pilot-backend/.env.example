# The real key belongs only in .env.local or your host's secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DATA_DIR=./data
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# In production, configure SMTP and HTTPS. Development writes private email previews in data/mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Protein Pilot <hello@example.com>
AI_DAILY_LIMIT=20
